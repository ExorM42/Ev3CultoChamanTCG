# Copiar a /etc/cultochaman/backend.env  (chmod 600, dueño root) y completar.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
PORT=8081

# Base de datos (MySQL local en la EC2, o el endpoint de RDS)
DATABASE_URL=jdbc:mysql://localhost:3306/cultochaman?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USER=cultochaman
DATABASE_PASSWORD=CAMBIAR_ESTA_CLAVE

# openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_VALOR_ALEATORIO_DE_48_BYTES
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Cuenta ADMIN inicial (se crea solo si el correo no existe)
ADMIN_EMAIL=admin@tudominio.cl
ADMIN_PASSWORD=CAMBIAR_CLAVE_ADMIN

# Origen del frontend (con Nginx mismo dominio: http://IP_PUBLICA o https://tudominio.cl)
FRONTEND_ORIGIN=http://IP_PUBLICA_EC2
